# VISTA-MCP configuration — copy to .env (auto-loaded via python-dotenv) or export.

# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=8100
# Shared bearer token the partner agent must send (Authorization: Bearer <token>).
# REQUIRED: the server refuses to start with an empty or the default 'vista-dev-token'
# unless MCP_ALLOW_INSECURE=1. Set a strong value in production and share it securely.
MCP_AUTH_TOKEN=vista-dev-token
# Local-dev escape hatches (leave UNSET/0 in production):
#   MCP_ALLOW_INSECURE=1       permit the dev/empty token (weak or no auth)
#   MCP_ALLOW_PRIVATE_FETCH=1  allow fetching private/loopback URLs (needed for the local
#                              test client, which serves the log on 127.0.0.1)
MCP_ALLOW_INSECURE=1
MCP_ALLOW_PRIVATE_FETCH=1
# Streaming fetch cap for the injected log URL (bytes). Default 50 MB.
MAX_LOG_BYTES=52428800

# --- Outbound TLS trust (log fetch + LogV forward + ORB ask) ---
# All outbound calls verify TLS by default, exactly like `curl` without `-k`. If a host's
# certificate is rejected the call fails as httpx.ConnectError in ~0.1s, before any HTTP
# request goes out, and the log line says "TLS certificate rejected".
#   * Certificate signed by an internal CA  → trust that CA (correct fix):
# MCP_FETCH_CA_BUNDLE=/etc/ssl/certs/fortinet-corp-ca.pem
#   * Certificate name/SAN doesn't match the host we dial (no CA bundle can fix this) →
#     skip verification for just those hosts (the scoped `curl -k`):
# MCP_FETCH_INSECURE_TLS_HOSTS=sa-staging.corp.fortinet.com
#   * Blunt global off switch — prefer the host list above:
# MCP_FETCH_INSECURE_TLS=0
# Verbosity of the terminal flow logs (INFO shows request/fetch/forward/result/send-back;
# DEBUG additionally previews the report text). One of DEBUG|INFO|WARNING|ERROR.
MCP_LOG_LEVEL=INFO

# --- Log Visualizer (AgentAssist) backend the Log_Analyzer_Visualizer tool proxies to ---
LOGV_API_BASE=http://127.0.0.1:8802/logVisualizer/api/agent_assist
# SPA base used to build the shareable + iframe links returned to the agent.
LOGV_VIEW_BASE=https://vista.fortinet.com/logVisualizer

# --- test client only ---
# MCP_URL=http://127.0.0.1:8100/mcp/

# --- AI Controller (routing + per-analyzer invocation planning) ---
# Runs on EVERY tool call: picks which optional analyzers to add AND plans how to call each
# analyzer from the contract its /discover just returned. Set 0 to fall back to the deterministic
# policy (run every optional analyzer, build each request straight from discovery).
AI_CONTROLLER_ENABLED=1
AI_CONTROLLER_GEN_URL=https://vista.fortinet.com/ai-mcp/ds4/generate
AI_CONTROLLER_FALLBACK_URL=https://vista.fortinet.com/ai-mcp/generate
AI_CONTROLLER_TIMEOUT=60
# AI_TOOL=IKE
# (The legacy names DEEPSEEK_GEN_URL / ANALYSIS_API_URL / DEEPSEEK_TIMEOUT are still honoured.)

# --- Durable job history + console Dashboard/History (Postgres) ---
# Unset ⇒ history is off and the server behaves exactly as before (live view only).
# Schema + prod psql commands: docs/db_setup.md   (and docs/db_setup.sql)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/usage_logs
MCP_DB_ENABLED=1
MCP_DB_AUTO_CREATE=1        # 1 = create tables if missing (dev). Set 0 in prod.
# MCP_DB_POOL_MAX=6
# MCP_DB_STORE_REPORTS=1    # 0 = store report lengths but not the text
# MCP_DB_QUEUE_MAX=20000
# MCP_JOBS_MEMORY=60        # live in-memory job window for the console
