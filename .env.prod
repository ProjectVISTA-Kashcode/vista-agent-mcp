# ==========================================================================
# VISTA-MCP — PRODUCTION .env
# --------------------------------------------------------------------------
# Copy to `.env` on the prod host (server.py auto-loads .env). Keep this file
# secret — it contains the shared bearer token. Do NOT commit the real token.
#
# Differences vs local/dev (IMPORTANT):
#   • MCP_ALLOW_INSECURE      — NOT set (prod must use a strong real token)
#   • MCP_ALLOW_PRIVATE_FETCH — NOT set (prod signed URLs are public; keep the
#                               SSRF guard ON so the fetcher can't hit internal hosts)
# ==========================================================================

# --- bind ---
MCP_HOST=0.0.0.0
MCP_PORT=8100

# --- auth (REQUIRED) ---
# Strong, secret, non-default bearer token the partner agent must send.
# Generate a fresh one, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=CHANGE_ME_TO_A_STRONG_SECRET_TOKEN

# --- SSRF / private fetch ---
# Leave BOTH of these UNSET in prod. The injected source_url is a public signed URL,
# so the SSRF guard must stay on. (Setting MCP_ALLOW_PRIVATE_FETCH=1 in prod would let a
# redirect/misfilled URL reach internal hosts — do not do it.)
# MCP_ALLOW_INSECURE=1
# MCP_ALLOW_PRIVATE_FETCH=1

# --- fetch limits ---
MAX_LOG_BYTES=52428800          # 50 MB streaming cap

# --- LogV (mandatory analyzer) — prod endpoints ---
LOGV_API_BASE=https://vista.fortinet.com/logVisualizer/api/agent_assist
LOGV_VIEW_BASE=https://vista.fortinet.com/logVisualizer

# --- ORB troubleshooting (fail-open) ---
ORB_ENABLED=1
ORB_ASK_URL=https://vista.fortinet.com/orb/api/ask
ORB_USERNAME=logV_mcp_call
ORB_TIMEOUT=180                 # ORB is deep-research (~40–140s); fail-open on timeout

# --- logging ---
MCP_LOG_LEVEL=INFO              # DEBUG also previews report text (verbose)

# --- TLS (optional; only if an internal endpoint needs it) ---
# MCP_FETCH_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
# MCP_FETCH_INSECURE_TLS_HOSTS=some-internal-host.corp.fortinet.com

# --- tool config path (optional; default is config/tool_enablement.json) ---
# TOOL_ENABLEMENT_PATH=/etc/vista-mcp/tool_enablement.json

# ==========================================================================
# NEW in this revision — set these in production
# ==========================================================================

# --- AI Controller (was "DeepSeek") ---
# It now runs on EVERY tool call: it selects the optional analyzers AND plans how each analyzer
# is invoked, from the contract that analyzer's /discover just returned. That is what lets an
# analyzer change its API (or a new analyzer be added in the GUI) with no code change here.
# Leaving it ON is the intended production setting; 0 falls back to the deterministic policy
# (run every optional analyzer, build every request straight from discovery).
AI_CONTROLLER_ENABLED=1
AI_CONTROLLER_GEN_URL=https://vista.fortinet.com/ai-mcp/ds4/generate
AI_CONTROLLER_FALLBACK_URL=https://vista.fortinet.com/ai-mcp/generate
AI_CONTROLLER_TIMEOUT=60
# AI_TOOL=IKE
# Legacy DEEPSEEK_GEN_URL / ANALYSIS_API_URL / DEEPSEEK_TIMEOUT are still read as a fallback,
# so an existing deployment keeps working if these are not set.

# --- Durable job history (Postgres) — powers the console's Dashboard + History ---
# REQUIRED for history/analytics. Unset ⇒ the server runs exactly as before, live view only.
# Create the schema FIRST with docs/db_setup.sql, then set MCP_DB_AUTO_CREATE=0 (below), so the
# app never needs DDL rights. Full instructions: docs/db_setup.md
DATABASE_URL=postgresql+psycopg://mobiususer:3hZaGGkIbKotDfMx@192.168.1.110:5432/usage_logs
MCP_DB_ENABLED=1
MCP_DB_AUTO_CREATE=0            # schema is created by hand in prod (docs/db_setup.sql)
MCP_DB_POOL_MAX=6
MCP_DB_STORE_REPORTS=1          # 0 = store report lengths but not the text (smaller DB)
MCP_DB_QUEUE_MAX=20000          # in-process write queue; writes NEVER block a tool call
MCP_JOBS_MEMORY=60              # live in-memory job window for the console
